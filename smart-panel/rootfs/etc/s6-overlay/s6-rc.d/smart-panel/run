#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Start the FastyBird Smart Panel backend
# ==============================================================================

declare log_level
declare token_secret

log_level=$(bashio::config 'log_level')
token_secret=$(bashio::config 'token_secret')

# Generate a random token secret if not provided
if bashio::var.is_empty "${token_secret}"; then
    token_secret=$(head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 32)
    bashio::log.info "Generated random token secret"
fi

export NODE_ENV="production"
export FB_BACKEND_PORT="3000"
export FB_APP_HOST="0.0.0.0"
export FB_CONFIG_PATH="/data/config"
export FB_DB_PATH="/data/db"
export FB_ADMIN_UI_PATH="/app/node_modules/@fastybird/smart-panel-admin/dist"
export FB_TOKEN_SECRET="${token_secret}"
export FB_LOG_LEVEL="${log_level}"
export FB_DB_MIGRATIONS_RUN="true"

# Make HA Supervisor token available to the backend
export SUPERVISOR_TOKEN="${SUPERVISOR_TOKEN:-}"

# Ensure data directories exist
mkdir -p /data/db /data/config

# Generate initial config.yaml on first start (preserves existing config)
if [ ! -f /data/config/config.yaml ]; then
    bashio::log.info "First start detected, generating initial configuration..."

    cat > /data/config/config.yaml <<EOF
plugins:
  influx-v1-plugin:
    enabled: false
  memory-storage-plugin:
    enabled: true
  devices-home-assistant-plugin:
    enabled: true
modules:
  storage-module:
    enabled: true
    primary_storage: memory-storage-plugin
    fallback_storage:
EOF

    bashio::log.info "Initial configuration generated"
fi

cd /app || bashio::exit.nok "Could not change to app directory"

# Run migrations via CLI (idempotent — safe on every start)
bashio::log.info "Running database migrations..."
node /app/node_modules/typeorm/cli.js migration:run \
    -d /app/node_modules/@fastybird/smart-panel-backend/dist/dataSource.js \
    || bashio::log.warning "Migration had issues"

bashio::log.info "Starting FastyBird Smart Panel..."
bashio::log.info "Log level: ${log_level}"

exec node /app/node_modules/@fastybird/smart-panel-backend/dist/main.js
